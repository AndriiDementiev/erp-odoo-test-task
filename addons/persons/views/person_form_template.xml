<odoo>
  <template id="person_form_template" name="Person Create Form">
    <t t-call="website.layout">
      <div class="container mt-5">
        <h2>Add New Person</h2>
        <form action="/persons/create" method="post" class="mt-3">
          <div class="form-group">
            <label>First Name</label>
            <input type="text" name="first_name" required="required" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Last Name</label>
            <input type="text" name="last_name" required="required" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Birthday</label>
            <input type="date" name="birthday" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Sex</label>
            <select name="sex" class="form-control">
              <option value="">-</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="non_binary">Non-binary</option>
            </select>
          </div>
          <button type="submit" class="btn btn-success mt-3">Create</button>
        </form>
      </div>
    </t>
  </template>
</odoo>
